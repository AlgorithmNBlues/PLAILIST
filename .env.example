# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Party Configuration
PARTY_START_TIME=auto
PARTY_NAME=UB Hacking Party

# Gemini Settings
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000

# Decision Settings
CALL_GEMINI_EVERY_N_SONGS=1
ENABLE_AUTO_PLAY=false
MANUAL_OVERRIDE_ENABLED=true

# Audio Analysis Settings
AUDIO_ANALYSIS_INTERVAL_SECONDS=5
MAX_SCORE_HISTORY_SIZE=720

# Database/Storage
SESSION_DATA_PATH=./sessions
SAVE_SESSION_DATA=true
